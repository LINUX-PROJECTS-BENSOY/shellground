{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@app": ["src/app/index.ts", "src/app"],
      "@app/*": ["src/app/*"],
      "@application": ["src/application/index.ts", "src/application"],
      "@application/*": ["src/application/*"],
      "@domain": ["src/domain/index.ts", "src/domain"],
      "@domain/*": ["src/domain/*"],
      "@features": ["src/features/index.ts", "src/features"],
      "@features/*": ["src/features/*"],
      "@infrastructure": ["src/infrastructure/index.ts", "src/infrastructure"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@runtime": ["src/runtime/index.ts", "src/runtime"],
      "@runtime/*": ["src/runtime/*"],
      "@terminal": ["src/terminal/index.ts", "src/terminal"],
      "@terminal/*": ["src/terminal/*"],
      "@shared": ["src/shared/index.ts", "src/shared"],
      "@shared/*": ["src/shared/*"],
      "@styles/*": ["src/styles/*"],
      "@content/*": ["content/*"]
    }
  },
  "include": ["src", "content", "tests"]
}
